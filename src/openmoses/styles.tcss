$om-bg: #090b0a;
$om-panel: #0e110f;
$om-raised: #141814;
$om-line: #252b26;
$om-line-soft: #1b201c;
$om-text: #e8eee6;
$om-muted: #899288;
$om-faint: #596259;
$om-lime: #d6ff52;

Screen {
    background: $om-bg;
    color: $om-text;
}

#dashboard {
    width: 100%;
    height: 100%;
    align: center middle;
}

#dashboard-content {
    width: 84;
    height: auto;
    max-height: 39;
}

#dashboard-art {
    width: 100%;
    height: 12;
    content-align: center middle;
    color: #9ba899;
}

#wordmark {
    width: 100%;
    height: 2;
    content-align: center middle;
    color: $om-lime;
    text-style: bold;
    border-bottom: solid $om-line;
}

#tagline {
    width: 100%;
    height: 2;
    content-align: center middle;
    color: $om-muted;
}

#dashboard-menu {
    width: 100%;
    height: 15;
    margin-top: 1;
    background: transparent;
    border: none;
    scrollbar-size: 0 0;
}

.dashboard-menu-item {
    width: 100%;
    height: 4;
    min-height: 4;
    layout: horizontal;
    background: $om-bg;
    color: $om-text;
    padding: 0 1;
}

#dashboard-menu:focus > .dashboard-menu-item.-highlight {
    background: $om-lime;
    color: #0a0d09;
    border-left: thick $om-lime;
}

#dashboard-menu:focus > .dashboard-menu-item.-highlight .menu-key,
#dashboard-menu:focus > .dashboard-menu-item.-highlight .menu-title,
#dashboard-menu:focus > .dashboard-menu-item.-highlight .menu-description,
#dashboard-menu:focus > .dashboard-menu-item.-highlight .menu-arrow {
    color: #0a0d09;
}

.menu-key {
    width: 5;
    height: 3;
    content-align: center middle;
    color: $om-lime;
    text-style: bold;
}

.menu-copy {
    width: 1fr;
    height: 3;
    padding-top: 1;
}

.menu-title {
    height: 1;
    color: $om-text;
    text-style: bold;
}

.menu-description {
    height: 1;
    color: $om-faint;
}

.menu-arrow {
    width: 3;
    height: 3;
    content-align: center middle;
    color: $om-faint;
}

#dashboard-hint {
    width: 100%;
    height: 3;
    content-align: center middle;
    color: $om-faint;
}

#dashboard-status {
    dock: bottom;
    width: 100%;
    height: 2;
    content-align: center middle;
    color: $om-faint;
    border-top: solid $om-line-soft;
}

.minimal-header {
    width: 100%;
    height: 3;
    min-height: 3;
    border-bottom: solid $om-line;
    padding: 0 2;
    align: left middle;
}

.mini-brand {
    width: 4;
    height: 1;
    color: $om-lime;
    text-style: bold;
}

.minimal-title {
    width: 1fr;
    height: 1;
    color: $om-text;
}

.minimal-action {
    width: auto;
    height: 1;
    color: $om-muted;
}

#chat-page,
#settings-page {
    width: 100%;
    height: 100%;
}

#settings-page {
    align-horizontal: center;
}

#conversation {
    width: 100%;
    height: 1fr;
    padding: 2 8;
    scrollbar-size: 1 1;
    scrollbar-color: #3d463e transparent;
}

#chat-empty-state {
    width: 100%;
    height: auto;
    margin-top: 5;
    color: $om-muted;
    text-align: center;
}

.message {
    width: 100%;
    height: auto;
    padding: 1 0;
    margin-bottom: 1;
    border-bottom: solid $om-line-soft;
}

.user-message {
    border-left: thick $om-line;
    padding-left: 2;
}

.assistant-message {
    border-left: thick $om-lime;
    padding-left: 2;
}

.message-header {
    height: 1;
    margin-bottom: 1;
}

.message-author {
    width: auto;
    color: $om-text;
    text-style: bold;
    margin-right: 1;
}

.message-role {
    width: auto;
    color: $om-faint;
}

.message-body {
    width: 100%;
    height: auto;
    color: #c9d0c7;
}

#composer-wrap {
    width: 100%;
    height: 5;
    min-height: 5;
    dock: bottom;
    background: $om-panel;
    border-top: solid $om-line;
    padding: 0 2;
}

#composer {
    width: 100%;
    height: 3;
    background: transparent;
    color: $om-text;
    border: none;
    padding: 0;
}

#composer:focus {
    border: none;
}

#composer-meta {
    width: 100%;
    height: 1;
    color: $om-faint;
}

.command-hints {
    width: 1fr;
}

.send-hint {
    width: auto;
    color: $om-muted;
}

#settings-content {
    width: 80;
    max-width: 90%;
    height: auto;
    margin: 3 0;
}

#settings-title {
    width: 100%;
    height: 2;
    color: $om-text;
    text-style: bold;
}

#settings-description {
    width: 100%;
    height: 2;
    color: $om-muted;
    border-bottom: solid $om-line;
}

#settings-list {
    width: 100%;
    height: auto;
    margin-top: 1;
}

.settings-item {
    width: 100%;
    height: 3;
    padding: 1;
    border-bottom: solid $om-line-soft;
    color: #c9d0c7;
}

#settings-note {
    width: 100%;
    height: 3;
    color: $om-faint;
    padding-top: 1;
}

Footer {
    height: 1;
    background: $om-panel;
    color: $om-muted;
}
